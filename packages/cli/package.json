{
  "name": "runray",
  "version": "0.1.0-alpha.4",
  "type": "module",
  "license": "MIT",
  "description": "Zero-config, local-first observability and token audit for local coding agents (Claude Code, OpenCode; OTLP import for others).",
  "keywords": [
    "claude-code",
    "opencode",
    "coding-agent",
    "tokens",
    "cost",
    "observability",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RunRay/runray.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/RunRay/runray#readme",
  "bugs": {
    "url": "https://github.com/RunRay/runray/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "runray": "bundle/bin.js"
  },
  "exports": {
    ".": {
      "import": "./bundle/index.js"
    }
  },
  "files": [
    "bundle",
    "assets"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "bundle": "node ./scripts/bundle.mjs",
    "prepack": "pnpm --filter @runray/core build && node ./scripts/prepack-ui.mjs && node ./scripts/prepack-meta.mjs && node ./scripts/bundle.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@runray/core": "workspace:*",
    "@runray/schema": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
