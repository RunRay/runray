~/.config/runray/
~/.config/tracepulse/
.cache/
.DS_Store

# Fixtures: never commit raw, unscrubbed logs
fixtures/**/raw/
*.raw.jsonl
*.raw.json

# Large perf fixture: too big for git history — generated locally per contributor.
# See fixtures/claude-code/large/README.md
fixtures/**/large/*.jsonl

# Local pricing overrides
pricing.local.json

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
otel/*