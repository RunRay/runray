# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-export/
packages/*/dist/
packages/cli/assets/
packages/cli/bundle/
# copied from the repo root at prepack (scripts/prepack-meta.mjs)
packages/cli/README.md
packages/cli/LICENSE

# Packing output — npm pack leaves the tarball in the package dir
*.tgz

# Test / coverage
coverage/
*.tsbuildinfo

